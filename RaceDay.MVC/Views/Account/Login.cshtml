@model RaceDay.MVC.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="text-center mb-4">Login to RaceDay</h2>

    <form asp-action="Login" method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="UserEmail" class="form-label">
                Email Address
            </label>

            <input asp-for="UserEmail"
                   class="form-control"
                   placeholder="Enter your email" />

            <span asp-validation-for="UserEmail"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">
                Password
            </label>

            <input asp-for="Password"
                   class="form-control"
                   placeholder="Enter your password" />

            <span asp-validation-for="Password"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Login
        </button>

        <p class="text-center mt-3">
            Don't have an account?
            <a asp-action="Register">Register here</a>
        </p>
    </form>
</div>
